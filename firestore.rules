rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Helper Functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Products Collection
    // Publicly readable so customers can browse catalog across devices;
    // Writable for catalog management
    match /products/{productId} {
      allow read: if isValidId(productId);
      allow create: if isValidId(productId)
        && incoming().name is string && incoming().name.size() <= 200
        && incoming().priceBDT is number
        && incoming().stockQuantity is number
        && incoming().inStock is bool;
      allow update: if isValidId(productId)
        && incoming().name is string
        && incoming().priceBDT is number
        && incoming().stockQuantity is number
        && incoming().inStock is bool;
      allow delete: if isValidId(productId);
    }

    // 2. Orders Collection
    // Customers can place orders via WhatsApp simulator / checkout;
    // Orders can be read for order tracking by order ID
    match /orders/{orderId} {
      allow read: if isValidId(orderId);
      allow create: if isValidId(orderId)
        && incoming().customerName is string && incoming().customerName.size() <= 100
        && incoming().customerPhone is string && incoming().customerPhone.size() <= 30
        && incoming().totalAmountBDT is number;
      allow update: if isValidId(orderId)
        && incoming().customerPhone is string;
      allow delete: if isValidId(orderId);
    }

    // 3. Reviews Collection
    // Publicly readable; customers can submit genuine reviews
    match /reviews/{reviewId} {
      allow read: if isValidId(reviewId);
      allow create: if isValidId(reviewId)
        && incoming().authorName is string && incoming().authorName.size() <= 100
        && incoming().rating is number
        && incoming().comment is string && incoming().comment.size() <= 1000;
      allow update: if isValidId(reviewId);
      allow delete: if isValidId(reviewId);
    }

    // 4. Store Settings Collection
    // Publicly readable so app knows WhatsApp phone and delivery fees;
    // Writable by staff / admin
    match /settings/{settingsId} {
      allow read: if isValidId(settingsId);
      allow create, update: if isValidId(settingsId)
        && incoming().whatsappNumber is string && incoming().whatsappNumber.size() <= 30
        && incoming().storeName is string && incoming().storeName.size() <= 100;
      allow delete: if false;
    }

    // 5. Customers Collection
    match /customers/{customerId} {
      allow read: if isValidId(customerId);
      allow create, update: if isValidId(customerId)
        && incoming().name is string && incoming().name.size() <= 100
        && incoming().phone is string && incoming().phone.size() <= 30;
      allow delete: if isValidId(customerId);
    }
  }
}
